{
  "name": "videotools",
  "version": "1.0.0",
  "description": "A web application with video tools: seamless loops, image sequences to video, and more",
  "private": true,
  "type": "module",
  "workspaces": [
    "client"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run vercel",
    "vercel": "vercel dev",
    "build": "npm run build --workspace client",
    "test": "npm run test --workspace client",
    "smoke": "node scripts/smoke.mjs",
    "postinstall": "node scripts/binaries-install.mjs",
    "ffmpeg:mirror": "node scripts/ffmpeg-mirror.mjs",
    "gifski:mirror": "node scripts/gifski-mirror.mjs",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "typecheck": "tsc -p tsconfig.json",
    "lint:fix": "npm run lint -- --fix"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "@vercel/node": "^16.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
