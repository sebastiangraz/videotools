{
  "name": "videotools",
  "version": "1.0.0",
  "description": "A web application with video tools: seamless loops, image sequences to video, and more",
  "private": true,
  "type": "module",
  "workspaces": [
    "client"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "npm run vercel",
    "vercel": "vercel dev",
    "build": "npm run build --workspace client",
    "test": "npm run test --workspace client",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "typecheck": "tsc -p tsconfig.json",
    "lint:fix": "eslint --flag unstable_native_nodejs_ts_config . --fix"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@vercel/blob": "^1.1.1",
    "ffmpeg-static": "^5.2.0",
    "nanoid": "^3.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@vercel/node": "^5.1.14",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0"
  }
}
