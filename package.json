{
  "name": "videotools",
  "version": "1.0.0",
  "private": true,
  "description": "A web application with video tools: seamless loops, image sequences to video, and more",
  "workspaces": [
    "client"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm run vercel",
    "vercel": "vercel dev",
    "build": "npm run build --workspace client",
    "test": "npm run test --workspace client",
    "smoke": "node scripts/smoke.mjs",
    "postinstall": "node scripts/binaries-install.mjs",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.json && tsc -p client",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@vercel/node": "^16.0.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": "24.x"
  }
}
