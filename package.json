{
  "name": "videotools",
  "version": "1.0.0",
  "private": true,
  "description": "A web application with video tools: seamless loops, image sequences to video, and more",
  "workspaces": [
    "client"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun --filter client dev",
    "engine": "bun api/_lib/serve.ts",
    "build:engine": "bun scripts/build-engine.ts",
    "build": "bun --filter client build",
    "test": "bun --filter client test",
    "smoke": "bun scripts/smoke/index.mjs",
    "postinstall": "bun api/_lib/binaries.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p client",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^24.19.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2"
  }
}
