{
  // Used by typecheck.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["bun"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  // vite.config.ts runs in Node, so it is checked here, not in client/.
  "include": ["api", "client/vite.config.ts"],
  "exclude": ["api/_bin"]
}
