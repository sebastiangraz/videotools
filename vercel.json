{
  "buildCommand": "npm run build --workspace client",
  "devCommand": "npm run dev --workspace client -- --port $PORT",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/((?!api/|@)[^.]*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/process.ts": {
      "maxDuration": 300,
      "includeFiles": "{api/_bin/ffmpeg/linux-x64/**,api/_bin/gifski/linux/**}"
    },
    "api/preview.ts": {
      "maxDuration": 60,
      "includeFiles": "{api/_bin/ffmpeg/linux-x64/**,api/_bin/gifski/linux/**}"
    },
    "api/upload.ts": { "maxDuration": 30 }
  }
}
