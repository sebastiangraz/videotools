{
  "name": "video-tools",
  "version": "0.1.0",
  "description": "Video tools on the command line: watermark many videos and images at once, as the videotools web app's Mark does. Built on ffmpeg.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastiangraz/videotools.git",
    "directory": "cli"
  },
  "bin": {
    "video-tools": "dist/index.js"
  },
  "files": [
    "dist",
    "gifski"
  ],
  "type": "module",
  "scripts": {
    "build": "bun build index.ts --target node --external @resvg/resvg-wasm --outfile dist/index.js"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2"
  },
  "devDependencies": {
    "@videotools/core": "workspace:*"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
