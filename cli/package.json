{
  "name": "@videotools/cli",
  "version": "0.1.6",
  "license": "Elastic-2.0",
  "description": "Video tools on the command line: seamless loops, image sequences to video, speed changes, format conversion and watermarks, for many files at once",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastiangraz/videotools.git",
    "directory": "cli"
  },
  "bin": {
    "videotools": "dist/index.js"
  },
  "files": [
    "dist",
    "gifski"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build index.ts --target node --external @resvg/resvg-wasm --outfile dist/index.js"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2"
  },
  "devDependencies": {
    "@videotools/core": "workspace:*"
  },
  "engines": {
    "node": ">=22.17.0"
  }
}
